{
  "manifest_version": 3,
  "name": "SUPER LOVABLE",
  "version": "1.4.0",
  "description": "SUPER LOVABLE: painel premium para a plataforma Lovable, com anexos, gravação de voz, fila real de comandos, histórico e ferramentas.",
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://storage.googleapis.com/*",
    "https://*.storage.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://painel-super-lov.lovable.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SUPER LOVABLE",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}