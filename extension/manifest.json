{
  "manifest_version": 3,
  "name": "SUPER LOVABLE V2 — TESTE",
  "version": "1.9.1",
  "description": "SUPER LOVABLE V2: edição autorizada por GitHub, integrações e seleção visual.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://painel-super-lov.lovable.app/*"
  ],
  "background": {
    "service_worker": "v2/background-v2.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["v2/runtime/visual-editor-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "v2/runtime/app.html",
    "default_title": "SUPER LOVABLE V2 — TESTE",
    "default_icon": {"48": "icon.png", "128": "icon.png"}
  },
  "icons": {"48": "icon.png", "128": "icon.png"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": ["https://*/*"]
}