{
  "manifest_version": 3,
  "name": "Superlovable",
  "version": "32.0.33",
  "description": "Superlovable — Assistente premium com licenciamento por key.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "sidePanel", "cookies"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "sidepanel.html",
    "default_title": "Superlovable",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "branding.config.js",
        "remote-branding.js",
        "jszip.min.js",
        "hwFingerprint.js",
        "fnx-license.js",
        "content-templates.js",
        "content.js",
        "visual-editor.js",
        "composer-bridge.js",
        "overlay.js"
      ],
      "css": ["floating.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*"],
      "matches": ["<all_urls>"]
    }
  ]
}
